# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Contact Form Delivery (Server-side only — never expose to client)
# Option 1: Resend API key and destination email
RESEND_API_KEY=""
CONTACT_TO_EMAIL="rishirajput261@gmail.com"
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Option 2: Generic webhook URL (e.g. Formspree, Make, Slack, Discord, custom endpoint)
CONTACT_WEBHOOK_URL=""
